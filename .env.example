# ─────────────────────────────────────────────────────────────────────────────
# AMORTIZE — example environment. Copy to .env and fill in.
#     cp .env.example .env
# .env is gitignored. Nothing here is ever committed.
# Every value below has a working default except the ones marked FILL ME.
#
# NOTE: comments go on their own line. `KEY=   # comment` makes dotenv read the
# comment text as the value.
# ─────────────────────────────────────────────────────────────────────────────

# --- upstream providers -----------------------------------------------------
# Fallback keys, used only when the *client* sends no credentials of its own.
# Amortize always prefers the caller's `x-api-key` / `Authorization` header, so
# tools like Claude Code keep working with their own auth and these may stay empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AMORT_UPSTREAM_ANTHROPIC=https://api.anthropic.com
AMORT_UPSTREAM_OPENAI=https://api.openai.com
NOVITA_API_URL=https://api.novita.ai/openai
NOVITA_MODEL=deepseek/deepseek-v4-flash
NOVITA_EMBED_MODEL=baai/bge-m3
NOVITA_API_KEY=

# --- amortize ---------------------------------------------------------------
AMORT_PORT=4000
# auto = try snowflake, fall back to sqlite | snowflake | sqlite
AMORT_LEDGER=auto
AMORT_MEMORY_DIR=.amort/memory
AMORT_SPILL_DIR=.amort/spill

# --- everos -----------------------------------------------------------------
# EverOS is a *service*, not a library: start it with `everos server start`.
#   local → a locally running everos server (default http://127.0.0.1:8000)
#   cloud → a hosted everos endpoint, authenticated with EVEROS_API_KEY
# If no server answers /health, Amortize degrades to a local markdown store under
# AMORT_MEMORY_DIR that follows EverOS's on-disk conventions (see store_everos.py).
EVEROS_MODE=local
# FILL ME only when EVEROS_MODE=cloud (booth credits)
EVEROS_API_KEY=
EVEROS_BASE_URL=http://127.0.0.1:8000
# agent scope that owns Amortize's Cases + Skills
EVEROS_AGENT_ID=amortize
EVEROS_APP_ID=amortize
EVEROS_PROJECT_ID=default

# --- snowflake (booth credits / trial account) ------------------------------
# FILL ME (account + user + password) to write the ledger to Snowflake.
# Leave empty to run on the local SQLite ledger — everything else is identical.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AMORTIZE
SNOWFLAKE_SCHEMA=LEDGER

# --- demo -------------------------------------------------------------------
# Model the demo harness drives. Must exist in amort/ledger/pricing.json.
AMORT_DEMO_MODEL=claude-haiku-4-5-20251001
