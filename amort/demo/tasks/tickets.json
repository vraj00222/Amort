  "kb": [
    {
      "doc_id": "KB-101",
      "title": "Resolving duplicate charges",
      "product_area": "billing",
      "summary": "Duplicate charges are usually a retry after a soft decline. Void the second authorization and issue a refund from the billing console."
    },
    {
      "doc_id": "KB-114",
      "title": "SSO login loops",
      "product_area": "auth",
      "summary": "A login loop almost always means the SAML ACS URL or clock skew is wrong. Re-upload IdP metadata and verify NTP on the IdP."
    },
    {
      "doc_id": "KB-132",
      "title": "Handling 429 responses",
      "product_area": "api",
      "summary": "Rate limits return 429 with retry-after when the bucket is per-key. A missing retry-after means the limit was org-wide; back off exponentially."
    },
    {
      "doc_id": "KB-147",
      "title": "Blank charts in Safari",
      "product_area": "dashboard",
      "summary": "Safari blocks the canvas worker without a same-site cookie. Clearing site data and upgrading to 17.4+ resolves it."
    },
    {
      "doc_id": "KB-158",
      "title": "Mobile cold-start crashes",
      "product_area": "mobile",
      "summary": "Cold-start crashes after an upgrade are a stale realm migration. Force a re-sync from Settings > Storage > Rebuild cache."
    },
    {
      "doc_id": "KB-166",
      "title": "Duplicate Slack notifications",
      "product_area": "integrations",
      "summary": "Duplicates mean two webhooks target the same channel, usually after a workspace re-install. Remove the older subscription."
    }
  ]
